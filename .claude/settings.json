{
  "extraKnownMarketplaces": {
    "rxap3r-tools": {
      "source": {
        "source": "github",
        "repo": "Rxap3r/Claude-Tools"
      }
    }
  },
  "enabledPlugins": {
    "cost-saver@rxap3r-tools": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-dev.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
